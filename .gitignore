# Environments
venv/
env/
.env
.venv/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Tests and tooling
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE and OS files
.vscode/
.idea/
*.swp
*.DS_Store
Thumbs.db

# Legacy fonts are licensed separately -- keep them out of the repo. They are
# only needed to re-verify a mapping table against its font.
*.ttf
*.otf
*.woff
*.woff2
!assets/*.ttf

# Sample PDFs and their conversions
*.pdf
*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!docs/*.md

# Superseded one-off debug scripts, kept locally but not published.
# Already tracked? Untrack once with:
#   git rm --cached analyze_errors.py test_brown.py test_detect.py \
#       test_example.py test_para.py test_output.txt
analyze_errors.py
test_brown.py
test_detect.py
test_example.py
test_para.py
test_output.txt

# Logo/banner tooling, not part of the package
crop_*.py
make_*.py
